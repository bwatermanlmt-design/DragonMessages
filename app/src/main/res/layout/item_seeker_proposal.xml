<?xml version="1.0" encoding="utf-8"?>
<!-- One proposed rule on the Suggest rules screen: tick it, see its evidence, create it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="12dp">

    <CheckBox
        android:id="@+id/proposal_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/proposal_pattern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/bigger_text_size"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/proposal_evidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:textSize="@dimen/normal_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/proposal_example"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:textSize="@dimen/normal_text_size"
            android:textStyle="italic" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/proposal_replaces"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:textSize="@dimen/normal_text_size"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
