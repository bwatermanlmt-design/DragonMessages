<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/macros_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/macros_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/macros_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/macros"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/macros_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/small_margin"
            android:paddingBottom="@dimen/activity_margin">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/import_rules_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_all_corners"
                android:padding="@dimen/activity_margin"
                android:text="@string/rules_import"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/export_rules_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_all_corners"
                android:padding="@dimen/activity_margin"
                android:text="@string/rules_export"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/no_macros_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/no_macros_yet"
                android:textSize="@dimen/bigger_text_size"
                android:textStyle="italic"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/macros_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:alpha="0.65"
                android:text="@string/rules_subtitle"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/new_macro_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:background="@drawable/ripple_all_corners"
                android:padding="@dimen/activity_margin"
                android:text="@string/new_macro"
                android:textSize="@dimen/bigger_text_size" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
