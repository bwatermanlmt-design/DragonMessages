<?xml version="1.0" encoding="utf-8"?>
<!-- One row on the Manage folders screen: colour dot, name, count. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="12dp">

    <View
        android:id="@+id/manage_folder_dot"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/folder_icon_background" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/manage_folder_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_weight="1"
        android:textSize="@dimen/bigger_text_size" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/manage_folder_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.65"
        android:textSize="@dimen/normal_text_size" />

</LinearLayout>
