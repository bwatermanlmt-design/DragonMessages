<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folder_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/folder_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/folder_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/mailboxes"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/folder_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/folder_rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin">

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/folder_view_hint"
                android:textSize="@dimen/normal_text_size" />

            <!-- Landing page, 2026-11-07: three sections, in this order.
                 Folders — Contacts, Not in Contacts, Auth and Businesses,
                 the user's own folders, Locker — reorderable, so the
                 activity re-attaches these holders (and inflates the
                 custom rows) into this container in the stored order.
                 Then Spam alone in its own section, then the actions. -->
            <LinearLayout
                android:id="@+id/folders_section_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/mailbox_contacts_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/mailbox_contacts_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_person_vector"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/mailbox_contacts_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_contacts"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.65"
                            android:text="@string/mailbox_contacts_subtitle"
                            android:textSize="@dimen/normal_text_size" />

                    </LinearLayout>

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_contacts_unread"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/small_margin"
                        android:background="@drawable/folder_pill_background"
                        android:backgroundTint="@color/mailbox_contacts_accent"
                        android:minWidth="28dp"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textAlignment="center"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_contacts_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/folder_pill_background"
                        android:backgroundTint="@color/mailbox_contacts_wash"
                        android:minWidth="36dp"
                        android:paddingStart="10dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/bigger_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mailbox_quarantine_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/mailbox_quarantine_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_question_mark_vector"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/mailbox_quarantine_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quarantine"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.65"
                            android:text="@string/mailbox_quarantine_subtitle"
                            android:textSize="@dimen/normal_text_size" />

                    </LinearLayout>

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_quarantine_unread"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/small_margin"
                        android:background="@drawable/folder_pill_background"
                        android:backgroundTint="@color/mailbox_quarantine_accent"
                        android:minWidth="28dp"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textAlignment="center"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_quarantine_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/folder_pill_background"
                        android:backgroundTint="@color/mailbox_quarantine_wash"
                        android:minWidth="36dp"
                        android:paddingStart="10dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/bigger_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mailbox_auth_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/mailbox_auth_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle_vector"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/mailbox_auth_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_and_services"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.65"
                            android:text="@string/mailbox_auth_subtitle"
                            android:textSize="@dimen/normal_text_size" />

                    </LinearLayout>

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_auth_unread"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/small_margin"
                        android:background="@drawable/folder_pill_background"
                        android:backgroundTint="@color/mailbox_auth_accent"
                        android:minWidth="28dp"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:textAlignment="center"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/normal_text_size"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_auth_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/folder_pill_background"
                        android:backgroundTint="@color/mailbox_auth_wash"
                        android:minWidth="36dp"
                        android:paddingStart="10dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/bigger_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mailbox_locker_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/mailbox_locker_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lock_vector"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/mailbox_locker_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/locker"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/mailbox_locker_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.65"
                            android:text="@string/locker_subtitle"
                            android:textSize="@dimen/normal_text_size" />

                    </LinearLayout>

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_locker_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/folder_pill_background"
                        android:backgroundTint="@color/mailbox_locker_wash"
                        android:minWidth="36dp"
                        android:paddingStart="10dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="2dp"
                        android:textAlignment="center"
                        android:textSize="@dimen/bigger_text_size" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginEnd="@dimen/activity_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:background="?android:attr/listDivider" />

            <LinearLayout
                android:id="@+id/mailbox_spam_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/mailbox_spam_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_block_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_spam_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spam"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/mailbox_spam_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_spam_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_spam_wash"
                    android:minWidth="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/bigger_text_size" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginEnd="@dimen/activity_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:background="?android:attr/listDivider" />

            <!-- Actions (2026-11-07): Rules, Import Rules, Export
                 messages, Export Rules, Suggest rules. New folder and
                 Manage folders stay in the toolbar overflow menu. The
                 Suggest rules row is a placeholder until the pattern
                 seeker is built — it says so when tapped. -->
            <LinearLayout
                android:id="@+id/actions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/action_rules_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/folder_action_macros_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_play_vector"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/macros"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.65"
                            android:text="@string/macros_subtitle"
                            android:textSize="@dimen/normal_text_size" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_import_rules_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/folder_action_new_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_unarchive_vector"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rules_import"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.65"
                            android:text="@string/rules_import_subtitle"
                            android:textSize="@dimen/normal_text_size" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_export_messages_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/folder_action_manage_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_document_vector"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/export_messages"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.65"
                            android:text="@string/export_messages_subtitle"
                            android:textSize="@dimen/normal_text_size" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_export_rules_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/folder_action_export_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_archive_vector"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rules_export"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.65"
                            android:text="@string/rules_export_subtitle"
                            android:textSize="@dimen/normal_text_size" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_suggest_rules_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/folder_icon_background"
                        android:backgroundTint="@color/folder_action_suggest_accent">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_vector_play_circle_outline"
                            app:tint="@android:color/white" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/medium_margin"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/suggest_rules"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
