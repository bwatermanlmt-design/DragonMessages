<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folder_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/folder_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/folder_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/mailboxes"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/folder_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/folder_rows_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin">

            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/folder_view_hint"
                android:textSize="@dimen/normal_text_size" />

            <LinearLayout
                android:id="@+id/mailbox_contacts_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/mailbox_contacts_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_contacts_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/my_contacts"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/mailbox_contacts_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_contacts_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/small_margin"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_contacts_accent"
                    android:minWidth="28dp"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/normal_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_contacts_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_contacts_wash"
                    android:minWidth="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/bigger_text_size" />

            </LinearLayout>

            <!-- Folder tools (revision 8, moved in revision 9): New folder, Manage folders
                 and Rules as visible rows in the list itself, placed inside the Contacts area
                 (Ben's leaning: below everything was suboptimal), so the entrances exist
                 on screen with no menu opened. They mirror the
                 system-folder rows (colour chip, bold name, one-line
                 subtitle) but carry no counts. The toolbar overflow
                 entries for the same three actions stay. -->
            <LinearLayout
                android:id="@+id/action_new_folder_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/folder_action_new_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_plus_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/new_folder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/new_folder_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_manage_folders_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/folder_action_manage_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_folder_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/manage_folders"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/manage_folders_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_macros_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/folder_action_macros_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/macros"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/macros_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

            <LinearLayout
                android:id="@+id/mailbox_auth_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/mailbox_auth_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_auth_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_and_services"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/mailbox_auth_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_auth_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/small_margin"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_auth_accent"
                    android:minWidth="28dp"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/normal_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_auth_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_auth_wash"
                    android:minWidth="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/bigger_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mailbox_quarantine_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/mailbox_quarantine_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_question_mark_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_quarantine_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quarantine"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/mailbox_quarantine_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_quarantine_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/small_margin"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_quarantine_accent"
                    android:minWidth="28dp"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/normal_text_size"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_quarantine_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_quarantine_wash"
                    android:minWidth="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/bigger_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mailbox_spam_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/mailbox_spam_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_block_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_spam_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spam"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/mailbox_spam_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_spam_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_spam_wash"
                    android:minWidth="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/bigger_text_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mailbox_locker_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/folder_icon_background"
                    android:backgroundTint="@color/mailbox_locker_accent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock_vector"
                        app:tint="@android:color/white" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/medium_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_locker_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/locker"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_locker_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.65"
                        android:text="@string/locker_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_locker_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/folder_pill_background"
                    android:backgroundTint="@color/mailbox_locker_wash"
                    android:minWidth="36dp"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/bigger_text_size" />

            </LinearLayout>

            <!-- Ben's own folders (revision 7) are inflated here at
                 runtime, one item_folder_row per folder, in creation
                 order, after the five system folders. -->
            <LinearLayout
                android:id="@+id/custom_folders_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
