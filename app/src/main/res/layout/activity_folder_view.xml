<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folder_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/folder_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/folder_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/mailboxes"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/folder_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin">

            <RelativeLayout
                android:id="@+id/mailbox_contacts_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/activity_margin">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_contacts_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/my_contacts"
                    android:textSize="@dimen/bigger_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_contacts_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.8"
                    android:textSize="@dimen/bigger_text_size" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mailbox_auth_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/activity_margin">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_auth_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/auth_and_services"
                    android:textSize="@dimen/bigger_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_auth_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.8"
                    android:textSize="@dimen/bigger_text_size" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mailbox_quarantine_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/activity_margin">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_quarantine_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/quarantine"
                    android:textSize="@dimen/bigger_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_quarantine_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.8"
                    android:textSize="@dimen/bigger_text_size" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mailbox_spam_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/activity_margin">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_spam_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/spam"
                    android:textSize="@dimen/bigger_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_spam_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.8"
                    android:textSize="@dimen/bigger_text_size" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/mailbox_locker_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/activity_margin">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/mailbox_locker_count"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_locker_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/locker"
                        android:textSize="@dimen/bigger_text_size" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/mailbox_locker_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:text="@string/locker_subtitle"
                        android:textSize="@dimen/normal_text_size" />

                </LinearLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/mailbox_locker_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.8"
                    android:textSize="@dimen/bigger_text_size" />

            </RelativeLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
