<?xml version="1.0" encoding="utf-8"?>
<!-- The macro editor: a plain form over one rule row — name, the
     criteria (all optional, all set criteria must match), the target
     folder, and the automatic toggle. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/macro_editor_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/macro_editor_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/macro_editor_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/new_macro"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/macro_editor_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/activity_margin"
            android:paddingTop="@dimen/activity_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:paddingBottom="@dimen/activity_margin">

            <org.fossify.commons.views.MyTextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/macro_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/macro_name_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/bigger_text_size" />

            </org.fossify.commons.views.MyTextInputLayout>

            <org.fossify.commons.views.MyTextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:hint="@string/macro_sender_contains">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/macro_sender_contains_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/bigger_text_size" />

            </org.fossify.commons.views.MyTextInputLayout>

            <org.fossify.commons.views.MyTextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:hint="@string/macro_keyword">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/macro_keyword_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:inputType="textMultiLine"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/bigger_text_size" />

            </org.fossify.commons.views.MyTextInputLayout>

            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/rule_regex_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:text="@string/rule_keyword_regex"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:alpha="0.65"
                android:text="@string/macro_sender_class"
                android:textSize="@dimen/normal_text_size" />

            <RadioGroup
                android:id="@+id/macro_sender_class_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_class_any"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_any_kind" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_class_long"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_long_number" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_class_short"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_short_code" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_class_alpha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_service_id" />

            </RadioGroup>

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:alpha="0.65"
                android:text="@string/macro_in_contacts"
                android:textSize="@dimen/normal_text_size" />

            <RadioGroup
                android:id="@+id/macro_in_contacts_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_contacts_either"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_either" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_contacts_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_yes" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_contacts_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_no" />

            </RadioGroup>

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:alpha="0.65"
                android:text="@string/macro_contains_link"
                android:textSize="@dimen/normal_text_size" />

            <RadioGroup
                android:id="@+id/macro_link_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_link_either"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_either" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_link_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_yes" />

            </RadioGroup>

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:alpha="0.65"
                android:text="@string/macro_replied_to"
                android:textSize="@dimen/normal_text_size" />

            <RadioGroup
                android:id="@+id/macro_replied_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_replied_either"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_either" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_replied_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_yes" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_replied_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_no" />

            </RadioGroup>

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:alpha="0.65"
                android:text="@string/macro_filed_by_hand"
                android:textSize="@dimen/normal_text_size" />

            <RadioGroup
                android:id="@+id/macro_hand_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_hand_either"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_either" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_hand_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_yes" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/macro_hand_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/macro_no" />

            </RadioGroup>

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:alpha="0.65"
                android:text="@string/rule_match_mode"
                android:textSize="@dimen/normal_text_size" />

            <RadioGroup
                android:id="@+id/rule_match_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/rule_match_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_match_all" />

                <org.fossify.commons.views.MyCompatRadioButton
                    android:id="@+id/rule_match_any"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rule_match_any" />

            </RadioGroup>

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:alpha="0.65"
                android:text="@string/macro_target_folder"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/macro_target_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:text="@string/rule_target_hint"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/macro_automatic_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@string/macro_automatic"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/macro_save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:background="@drawable/ripple_all_corners"
                android:padding="@dimen/activity_margin"
                android:text="@string/save"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/macro_delete_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:background="@drawable/ripple_all_corners"
                android:padding="@dimen/activity_margin"
                android:text="@string/delete_macro"
                android:textSize="@dimen/bigger_text_size"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
