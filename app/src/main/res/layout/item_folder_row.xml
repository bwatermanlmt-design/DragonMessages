<?xml version="1.0" encoding="utf-8"?>
<!-- One custom-folder row on the folder view, mirroring the static
     system-folder rows in activity_folder_view.xml; the chip tint, glyph,
     texts and pill tints are set from the folder's stored colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/folder_row_icon_holder"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/folder_icon_background">

        <ImageView
            android:id="@+id/folder_row_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_folder_vector"
            app:tint="@android:color/white" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_weight="1"
        android:orientation="vertical">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/folder_row_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/bigger_text_size"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/folder_row_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.65"
            android:textSize="@dimen/normal_text_size" />

    </LinearLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/folder_row_unread"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/small_margin"
        android:background="@drawable/folder_pill_background"
        android:minWidth="28dp"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="@dimen/normal_text_size"
        android:textStyle="bold"
        android:visibility="gone" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/folder_row_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/folder_pill_background"
        android:minWidth="36dp"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:textAlignment="center"
        android:textSize="@dimen/bigger_text_size" />

</LinearLayout>
